# Copy beside deploy/stack.yml (or paste into the Komodo stack's environment) and fill in.
# Only UPSTREAM_URL (if llama-swap is not on this host's loopback) and MODEL are really decisions;
# the rest have defaults that match MiniMax-Music3 and radiance.

# The image to run. Leave this out of the stack's environment to take the ghcr.io default in
# deploy/stack.yml, set it to a commit sha to pin (`scripts/publish.sh --compose` prints that
# stack), or set it to a local `scripts/build.sh` tag while you are changing the page.
IMAGE=ghcr.io/apfrancis1992/radiance-studio:latest

# The port the GUI listens on, on the host.
PORT=8090

# llama-swap. Radiance's own container is not the target: the page names a model per request and
# llama-swap decides which server to have running.
UPSTREAM_URL=http://127.0.0.1:8080

# llama-swap's `apikey:` value, if it has one. Empty sends no Authorization header at all.
UPSTREAM_API_KEY=

# The model id to preselect: the name llama-swap gives the MiniMax-Music3 entry in its config, not
# the .rad file radiance loads. Empty picks the first id that looks like a music model.
MODEL=minimax-music3

APP_TITLE=radiance studio

# Play each window as it is made rather than waiting for the whole song.
STREAM_DEFAULT=true

# The length slider: ceiling and starting value, in seconds. 360 is the model's ceiling.
MAX_DURATION=360
DEFAULT_DURATION=30

# How long a request may go without a byte back, in seconds. Covers a cold load of the 20 GiB
# checkpoint after llama-swap hands it the cards.
REQ_TIMEOUT=1800

# Only consulted when UPSTREAM_URL names a host: 127.0.0.11 is Docker's resolver inside a network,
# 127.0.0.53 is systemd-resolved on the host.
RESOLVER=127.0.0.11
