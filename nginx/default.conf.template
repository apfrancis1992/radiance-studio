# nginx/default.conf.template -- the whole server, as the container writes it: the stock
# entrypoint runs envsubst over this file with the environment it was given and drops the result in
# /etc/nginx/conf.d/default.conf. Only brace-wrapped names the environment defines are substituted,
# and the Dockerfile's ENV defines every one used here, so nginx's own variables -- written without
# braces -- come through untouched.
#
# The GUI is static files and nothing else: no build step, no runtime. llama-swap does the
# inference. Everything the page asks of a model leaves through one regex location, so the key and
# the timeouts are configured exactly once.
#
# The sizing below follows the model, not HTTP convention. MiniMax-Music3 renders a song at about
# the speed it plays, and the first request after llama-swap picks it hands the GPU to it: a 20 GiB
# checkpoint takes minutes to load before a single byte of audio moves. `${REQ_TIMEOUT}` is that
# wait, and it is why the page streams by default (the first window of a song arrives in seconds,
# and each event keeps every idle timer in the path awake).

server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    # Where the models are. No trailing slash needed; one is removed if given.
    set $upstream "${UPSTREAM_URL}";
    if ($upstream ~ ^(.+)/$) { set $upstream $1; }

    # The key reaches llama-swap here, not in the page. With no key configured the header is
    # dropped rather than sent as an empty "Bearer ", which a keyed llama-swap would refuse.
    set $rad_auth "Bearer ${UPSTREAM_API_KEY}";
    if ($rad_auth = "Bearer ") { set $rad_auth ""; }

    # Only consulted when UPSTREAM_URL names a host instead of an address; a request to an IP
    # literal never asks. Docker's built-in resolver is 127.0.0.11 inside a bridge network.
    resolver ${RESOLVER} valid=30s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 4m;      # lyrics and instructions, nothing bigger than a paste
    send_timeout ${REQ_TIMEOUT}s;
    keepalive_timeout 75s;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    # Komodo's healthcheck asks this, and it answers whether this container serves, which is all a
    # container healthcheck can say: the model is llama-swap's business and the status pill reads
    # /health below for it.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # What the page reads at startup: the model to preselect, the title, and the limits to offer.
    # Every value is quoted so an unexpected setting cannot break the JSON; the page coerces.
    location = /config.json {
        default_type application/json;
        return 200 '{"model":"${MODEL}","title":"${APP_TITLE}","stream":"${STREAM_DEFAULT}","maxDuration":"${MAX_DURATION}","defaultDuration":"${DEFAULT_DURATION}","requestTimeout":"${REQ_TIMEOUT}"}';
    }

    # One block for everything that belongs to llama-swap: the OpenAI routes the page calls
    # (/v1/models, /v1/audio/speech), its health line, its "what is loaded" line, and the unload
    # button. A regex location, so it takes one block for all four paths and $request_uri carries
    # each path and query through unchanged.
    location ~ ^/(v1/|health$|running$|api/models/unload$) {
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Authorization $rad_auth;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;           # for an https:// UPSTREAM_URL

        # Streaming, which is the point of the page: a song's audio windows must reach the browser
        # as radiance writes them, and llama-swap itself streams what its upstream streams.
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering on;
        add_header X-Accel-Buffering no always;

        proxy_connect_timeout 10s;
        proxy_send_timeout ${REQ_TIMEOUT}s;
        proxy_read_timeout ${REQ_TIMEOUT}s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
